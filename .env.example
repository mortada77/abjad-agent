# =====================================================================
# Abjad Agi — WhatsApp AI Agent | Environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# =====================================================================

# ---------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------
# Which provider to use: "anthropic" or "openai"
AI_PROVIDER=anthropic

# --- Anthropic (Claude) ---
# Get a real API key from https://console.anthropic.com  (NOT a Claude Pro subscription)
ANTHROPIC_API_KEY=
# Model. Default is high quality. For a high-volume support bot, cheaper options:
#   claude-opus-5    -> best quality  ($5 / $25 per 1M tokens)
#   claude-sonnet-5  -> great balance ($2 / $10 per 1M tokens)   <- recommended for cost/quality
#   claude-haiku-4-5 -> cheapest+fast ($1 / $5  per 1M tokens)
ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI (only used if AI_PROVIDER=openai) ---
# Get a real API key from https://platform.openai.com  (NOT a ChatGPT Plus subscription)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------
# AI behaviour / cost limits
# ---------------------------------------------------------------------
# Max tokens per reply (WhatsApp replies are short; keeps cost + latency low)
AI_MAX_TOKENS=700
# Timeout for a single AI request (ms)
AI_TIMEOUT_MS=45000
# Retries on transient AI failures
AI_MAX_RETRIES=2
# Max concurrent AI requests across all users (global rate limit)
AI_MAX_CONCURRENCY=3

# ---------------------------------------------------------------------
# Conversation memory (keeps API cost bounded)
# ---------------------------------------------------------------------
# How many recent messages (user+assistant) to send to the model each time
MAX_HISTORY_MESSAGES=12
# When stored history for a contact exceeds this, older messages are summarised
SUMMARY_TRIGGER_MESSAGES=30

# ---------------------------------------------------------------------
# Human takeover
# ---------------------------------------------------------------------
# When a human (you) replies manually to a customer from WhatsApp, AI pauses
# for this contact for this many minutes, then resumes automatically.
HUMAN_TAKEOVER_MINUTES=30

# ---------------------------------------------------------------------
# WhatsApp
# ---------------------------------------------------------------------
# Ignore group messages entirely (recommended: true)
IGNORE_GROUPS=true
# Debounce: wait this long (ms) after the last message before replying,
# so several quick messages are answered together.
DEBOUNCE_MS=2500

# ---------------------------------------------------------------------
# Health / status HTTP server
# ---------------------------------------------------------------------
# Port for the internal health API + QR pairing page. Confirmed free on the VPS.
PORT=47850
# Token required to view the pairing QR page at /qr?token=...
# Set to a random string. It is also printed to the logs on startup.
PAIRING_TOKEN=change-me-to-a-random-string

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
